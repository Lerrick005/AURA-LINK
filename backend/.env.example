# =============================================================================
# AURALINK — Backend environment template
# Copy this file to .env and edit the marked values.
# .env is git-ignored; .env.example is committed.
# DO NOT commit real secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=auralink
APP_ENV=dev                              # dev | staging | prod
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Networking --------------------------------------------------------------
# Comma-separated. Wildcard '*' is rejected outside dev.
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Must use the postgresql+asyncpg:// scheme. Hosted locally by infra/docker-compose.yml.
# Change the password before any non-local deployment.
DATABASE_URL=postgresql+asyncpg://auralink_app:changeme_app_local_only@localhost:5432/auralink
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Auth / Sessions ---------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters. The REPLACE_ME value below is intentional: it passes
# validation so the app boots, but you MUST replace it before doing anything real.
JWT_SECRET=REPLACE_ME_use_secrets_token_urlsafe_48_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# --- Rate limits -------------------------------------------------------------
RL_DEFAULT_PER_MINUTE=120
RL_AUTH_PER_MINUTE=20
RL_CHANNEL_PER_MINUTE=600

# --- LLM (required from Milestone 2; leave commented until provider is chosen) -
# See docs/adr/0003a-primary-llm-provider.md
#LLM_PROVIDER=openai                      # openai | azure-openai | vllm
#LLM_API_KEY=REPLACE_ME
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_REQUEST_TIMEOUT_SECONDS=60
#LLM_DEFAULT_MAX_OUTPUT_TOKENS=1024

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
LOG_JSON=true
# Owner role for Alembic migrations only (bypasses RLS by design).
ALEMBIC_DATABASE_URL=postgresql+asyncpg://auralink:changeme_local_only@localhost:5432/auralink
